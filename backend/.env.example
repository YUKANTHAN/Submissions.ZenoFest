# ===== ZenoFest Event Data Submission - environment =====

# Google service account (same one used by the registration backend).
# Option A: path to a local JSON file.
# Option B (Render-friendly): paste the ENTIRE JSON here; it gets written to
# GOOGLE_SERVICE_ACCOUNT_PATH automatically.
GOOGLE_SERVICE_ACCOUNT=service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# ID of the ORGANIZED sheet from the registration backend
# (long string from docs.google.com/spreadsheets/d/<ID>/...)
ORGANIZED_SHEET_ID=
ORGANIZED_TAB_NAME=Sheet1

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Drive - folder where the DOCX lives
DRIVE_FOLDER_ID=

# DOCX file ID inside DRIVE_FOLDER_ID. Leave blank to auto-create on first use.
DRIVE_DOCX_FILE_ID=

# SMTP email (Gmail with an App Password - required to send the PDF receipt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=ZenoFest 2026

# Server port (Render overrides automatically)
PORT=8081